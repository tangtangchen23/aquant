<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="4dp">

        <!-- 头部：图标 + 标题 + 副标题 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_dialog_icon"
                android:backgroundTint="@color/set_tint_update">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="升级" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/set_update" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="系统更新" android:textSize="17sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:text="版本信息 · 检查升级" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="查看当前版本并检测是否有新版本可升级。" />

        <!-- 当前版本 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="当前版本" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/text_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp"
            android:padding="14dp" android:background="@drawable/bg_card">
        <TextView android:id="@+id/tv_version_dialog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="新版本将直接从内置升级地址下载安装。" />
        </LinearLayout><!-- /当前版本卡片 -->

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- 检测 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="检测升级" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <Button android:id="@+id/btn_check_update_dialog" android:layout_width="match_parent"
            android:layout_height="46dp" android:layout_marginTop="10dp" android:minHeight="0dp"
            android:text="检查更新" android:textSize="15sp"
            android:textColor="?attr/dialogActionOnPrimary" android:background="@drawable/bg_btn_primary" />
    </LinearLayout>
</ScrollView>