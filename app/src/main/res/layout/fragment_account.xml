<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="模拟账户" android:textSize="20sp" android:textStyle="bold" />

    <TextView android:id="@+id/tv_account_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp"
        android:background="@drawable/bg_card" android:textSize="15sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="持仓(点击查看K线)" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/btn_clear_positions" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="6dp" android:textColor="@color/brand"
            android:textSize="14sp" android:text="一键清仓" />
        <TextView android:id="@+id/btn_refresh_positions" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="6dp" android:textColor="@color/brand"
            android:textSize="14sp" android:text="↻ 刷新市值" />
    </LinearLayout>
    <ListView android:id="@+id/list_positions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_card"
        android:padding="4dp" android:divider="@color/bg" android:dividerHeight="1dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="成交记录" android:layout_marginTop="12dp" android:textStyle="bold" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/btn_trade_all" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="全部" android:textSize="13sp"
            android:textColor="#FFFFFF" android:backgroundTint="@color/brand" />
        <Button android:id="@+id/btn_trade_buy" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="买入" android:textSize="13sp"
            android:textColor="#FFFFFF" android:backgroundTint="@color/brand" />
        <Button android:id="@+id/btn_trade_sell" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="卖出" android:textSize="13sp"
            android:textColor="#FFFFFF" android:backgroundTint="@color/brand" />
    </LinearLayout>
    <ListView android:id="@+id/list_trades" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp"
        android:background="@drawable/bg_card" android:padding="4dp" />

    <Button android:id="@+id/btn_reset" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="重置模拟盘(重新注入资金)" />
</LinearLayout>