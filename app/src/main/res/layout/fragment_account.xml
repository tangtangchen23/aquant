<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="模拟账户" android:textSize="20sp" android:textStyle="bold" />

    <TextView android:id="@+id/tv_account_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp"
        android:background="#FFFFFF" android:textSize="15sp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="持仓" android:layout_marginTop="12dp" android:textStyle="bold" />
    <ListView android:id="@+id/list_positions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="#FFFFFF" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="成交记录" android:layout_marginTop="12dp" android:textStyle="bold" />
    <ListView android:id="@+id/list_trades" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp"
        android:background="#FFFFFF" />

    <Button android:id="@+id/btn_reset" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="重置模拟盘(重新注入资金)" />
</LinearLayout>