<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="模拟账户" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView android:id="@+id/tv_account_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="14dp"
                android:background="@drawable/bg_card" android:textSize="15sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="持仓(点击查看K线)" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:id="@+id/btn_clear_positions" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:padding="6dp" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:text="一键清仓" />
                <TextView android:id="@+id/btn_refresh_positions" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:padding="6dp" android:textColor="@color/text_primary"
                    android:textSize="14sp" android:text="↻ 刷新市值" />
            </LinearLayout>
            <!-- 持仓列表：动态撑开，随持仓数增长，整页可滚动 -->
            <LinearLayout android:id="@+id/list_positions_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="2dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="挂单（等待成交）" android:layout_marginTop="12dp" android:textStyle="bold" android:textSize="16sp" />
            <LinearLayout android:id="@+id/list_pending_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="2dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="成交记录" android:layout_marginTop="12dp" android:textStyle="bold" android:textSize="16sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_trade_all" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="全部" android:textSize="13sp"
                    android:textColor="?attr/onBrand" android:background="@drawable/bg_btn_primary"
                    android:minHeight="0dp" />
                <Button android:id="@+id/btn_trade_buy" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="买入" android:textSize="13sp"
                    android:textColor="?attr/onBrand" android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_primary" android:minHeight="0dp" />
                <Button android:id="@+id/btn_trade_sell" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="卖出" android:textSize="13sp"
                    android:textColor="?attr/onBrand" android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_primary" android:minHeight="0dp" />
            </LinearLayout>
            <!-- 成交记录列表：动态撑开，多笔完全展示，随整页滚动 -->
            <LinearLayout android:id="@+id/list_trades_container" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="2dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>