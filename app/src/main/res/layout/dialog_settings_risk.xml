<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="4dp">

        <!-- 分类徽标 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:background="@drawable/chip_risk"
            android:text="风控设置" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/set_risk" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="设置止损止盈、回撤熔断与出场策略，0 表示关闭对应规则。" />

        <!-- 基础风控 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="基础风控" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/set_risk" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="单票止损%" />
                <EditText android:id="@+id/et_stop_loss_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:hint="5"
                    android:inputType="numberDecimal" android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="单票止盈%" />
                <EditText android:id="@+id/et_take_profit_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:hint="10"
                    android:inputType="numberDecimal" android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="回撤熔断%" />
                <EditText android:id="@+id/et_max_dd_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:hint="20"
                    android:inputType="numberDecimal" android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- 出场策略 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="出场策略" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/set_risk" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="仅自动交易生效，可组合使用" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="移动止盈·启动盈利%" />
                <EditText android:id="@+id/et_trail_activate_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="移动止盈·回撤离场%" />
                <EditText android:id="@+id/et_trail_stop_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="保本止损·启动%" />
                <EditText android:id="@+id/et_breakeven_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="ATR止损·开关(1/0)" />
                <EditText android:id="@+id/et_atr_enabled_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="number"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="ATR止损·倍数" />
                <EditText android:id="@+id/et_atr_mult_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="建仓·首仓比例" />
                <EditText android:id="@+id/et_first_buy_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="加仓·每档比例" />
                <EditText android:id="@+id/et_add_pct_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="加仓·盈利档位%" />
                <EditText android:id="@+id/et_add_thr_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:inputType="numberDecimal"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>