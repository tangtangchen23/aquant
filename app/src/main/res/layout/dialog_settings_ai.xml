<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="4dp">

        <!-- 头部：图标 + 标题 + 副标题 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_dialog_icon"
                android:backgroundTint="@color/set_tint_ai">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AI" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/set_ai" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AI 设置" android:textSize="17sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:text="回测与持仓深度解读" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="接入大模型，提供回测与持仓的深度解读（可选功能）。" />

        <!-- 连接配置 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="连接配置" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/text_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp"
            android:padding="14dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="服务商" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <Spinner android:id="@+id/sp_ai_provider_dialog" android:layout_width="match_parent"
            android:layout_height="44dp" android:layout_marginTop="6dp"
            android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:background="@drawable/bg_spinner"
            android:textColor="@color/text_primary" android:spinnerMode="dropdown" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="API Key" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <EditText android:id="@+id/et_ai_key_dialog" android:layout_width="match_parent"
            android:layout_height="44dp" android:layout_marginTop="6dp"
            android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:background="@drawable/bg_input"
            android:textSize="13sp" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" android:hint="粘贴 API Key（仅存本机）"
            android:inputType="textPassword" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="模型名称" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <EditText android:id="@+id/et_ai_model_dialog" android:layout_width="match_parent"
            android:layout_height="44dp" android:layout_marginTop="6dp"
            android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:background="@drawable/bg_input"
            android:textSize="13sp" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" android:hint="如 deepseek-chat"
            android:inputType="text" android:singleLine="true" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:text="密钥仅保存在本机。AI 仅负责分析与建议，不会接触真实交易。" />
        </LinearLayout><!-- /连接配置卡片 -->

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- 检测与保存 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="检测与保存" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/btn_ai_test_dialog" android:layout_width="0dp"
                android:layout_height="46dp" android:layout_weight="1" android:minHeight="0dp"
                android:text="测试连接" android:textSize="14sp"
                android:textColor="?attr/dialogActionOnSecondary" android:background="@drawable/bg_btn_dialog_secondary" />
            <Button android:id="@+id/btn_ai_save_dialog" android:layout_width="0dp"
                android:layout_height="46dp" android:layout_weight="1" android:minHeight="0dp"
                android:layout_marginStart="8dp"
                android:text="保存AI配置" android:textSize="14sp"
                android:textColor="?attr/dialogActionOnSecondary" android:background="@drawable/bg_btn_dialog_secondary" />
        </LinearLayout>
        <TextView android:id="@+id/tv_ai_status_dialog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>