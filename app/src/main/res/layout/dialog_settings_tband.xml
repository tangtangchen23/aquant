<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">

        <!-- 弹窗头部：图标气泡 + 标题 + 副标题 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="42dp" android:layout_height="42dp"
                android:gravity="center" android:background="@drawable/bg_row_icon"
                android:backgroundTint="@color/set_tint_tband">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="做" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/set_tband" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="做T设置" android:textStyle="bold" android:textSize="17sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="日内高抛低吸 · 数据源与档位"
                    android:textSize="12sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 做T数据源 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="做T数据源" android:textStyle="bold"
            android:textSize="13sp" android:textColor="@color/text_primary" />
        <RadioGroup android:id="@+id/rg_tfreq_dialog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/rb_tfreq_1min_dialog" android:layout_width="0dp"
                android:layout_height="44dp" android:layout_weight="1"
                android:button="@null" android:background="@drawable/bg_option"
                android:gravity="center" android:text="分时线（更频繁）"
                android:textSize="12sp" android:textColor="@color/option_text" android:minHeight="0dp" />
            <RadioButton android:id="@+id/rb_tfreq_60min_dialog" android:layout_width="0dp"
                android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="8dp"
                android:button="@null" android:background="@drawable/bg_option"
                android:gravity="center" android:text="60分K线（更稳）"
                android:textSize="12sp" android:textColor="@color/option_text" android:minHeight="0dp" />
        </RadioGroup>

        <!-- 档位参数 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="做T底仓占目标仓位比例（0~1）" android:textSize="13sp"
                android:textColor="@color/text_secondary" />
            <EditText android:id="@+id/et_t_base_dialog" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="4dp"
                android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp" android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="做T每档交易占比（0~1）" android:textSize="13sp"
                android:textColor="@color/text_secondary" />
            <EditText android:id="@+id/et_t_band_dialog" android:layout_width="match_parent"
                android:layout_height="46dp" android:layout_marginTop="4dp"
                android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/bg_input"
                android:textSize="14sp" android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>