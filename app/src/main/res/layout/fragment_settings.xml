<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp" android:paddingBottom="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="设置" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="设置项" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/text_secondary" />

            <!-- 交易设置 -->
            <LinearLayout android:id="@+id/row_trade" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_trade">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交易" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_trade" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交易设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交易模式 · 资金 · 仓位 · 重置模拟盘"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 做T设置 -->
            <LinearLayout android:id="@+id/row_tband" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_tband">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="做T" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_tband" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="做T设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="日内高抛低吸 · 数据源与档位"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 风控设置 -->
            <LinearLayout android:id="@+id/row_risk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_risk">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="风控" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_risk" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="风控设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="止损止盈 · 回撤 · 移动止盈 · 加仓"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 行情提醒 -->
            <LinearLayout android:id="@+id/row_alert" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_alert">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="提醒" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_alert" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="行情提醒" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="到价推送通知 · 上穿/跌破目标价"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- AI设置 -->
            <LinearLayout android:id="@+id/row_ai" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_ai">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/set_ai" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="大模型连接 · API Key · 深度解读"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 实盘设置 -->
            <LinearLayout android:id="@+id/row_live" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_live">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="实盘" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_live" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="实盘设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="信号网关 · 输出到 QMT/EasyTrader"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 外观主题 -->
            <LinearLayout android:id="@+id/row_theme" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_theme">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="主题" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_theme" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="外观主题" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="浅色 · 深色 · 跟随系统 · 红色"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 系统更新 -->
            <LinearLayout android:id="@+id/row_update" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_update">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="升级" android:textSize="12sp" android:textStyle="bold"
                        android:textColor="@color/set_update" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="系统更新" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="当前版本 · 检查与升级"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <TextView android:id="@+id/tv_info" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>