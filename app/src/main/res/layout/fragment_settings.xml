<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="设置" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="交易模式" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rg_mode" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_paper" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="模拟盘(默认)" />
            <RadioButton android:id="@+id/rb_live" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="实盘信号" />
        </RadioGroup>
        <TextView android:id="@+id/tv_mode_hint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="外观主题" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rg_theme" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_theme_sys" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="跟随系统" />
            <RadioButton android:id="@+id/rb_theme_light" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="浅色" />
            <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="深色" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="行情到价提醒" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <EditText android:id="@+id/et_alert_symbol" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:hint="代码，如600519" />
            <EditText android:id="@+id/et_alert_price" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="0.7"
                android:textSize="13sp" android:hint="目标价" android:inputType="numberDecimal" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <Spinner android:id="@+id/sp_alert_dir" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" />
            <Button android:id="@+id/btn_add_alert" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="添加" />
        </LinearLayout>
        <TextView android:id="@+id/tv_alerts" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="13sp" android:textColor="@color/text_secondary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="模拟初始资金" android:textStyle="bold" />
        <EditText android:id="@+id/et_capital" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="轮询间隔(秒,>=5)" android:textStyle="bold" />
        <EditText android:id="@+id/et_poll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:inputType="number" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="单次开仓资金比例(0~1)" android:textStyle="bold" />
        <EditText android:id="@+id/et_pct" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="风控规则(0表示关闭)" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <EditText android:id="@+id/et_stop_loss" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="单票止损%" android:textSize="13sp" android:inputType="numberDecimal" />
            <EditText android:id="@+id/et_take_profit" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="单票止盈%" android:textSize="13sp" android:inputType="numberDecimal" />
            <EditText android:id="@+id/et_max_dd" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="回撤熔断%" android:textSize="13sp" android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="实盘网关URL(可选,对接QMT/EasyTrader)" android:textStyle="bold" />
        <EditText android:id="@+id/et_gateway" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:inputType="textUri" />
        <TextView android:id="@+id/tv_gateway_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="AI 大模型（可选）" android:textStyle="bold" />
        <Spinner android:id="@+id/sp_ai_provider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <EditText android:id="@+id/et_ai_key" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1.6"
                android:textSize="13sp" android:hint="API Key（仅存本机）"
                android:inputType="textPassword" />
            <EditText android:id="@+id/et_ai_model" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="13sp" android:hint="模型名" android:singleLine="true" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:text="用于回测/持仓的AI深度解读。密钥仅保存在本机，AI只做分析与建议，不会接触交易。" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btn_ai_test" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="测试连接" />
            <Button android:id="@+id/btn_ai_save" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="保存AI配置" />
        </LinearLayout>
        <TextView android:id="@+id/tv_ai_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="当前版本" android:textStyle="bold" />
        <TextView android:id="@+id/tv_version" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="新版本将直接从内置升级地址下载安装" android:textStyle="bold" />
        <Button android:id="@+id/btn_check_update" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="检查更新" />

        <Button android:id="@+id/btn_save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="保存设置" />

        <TextView android:id="@+id/tv_info" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>