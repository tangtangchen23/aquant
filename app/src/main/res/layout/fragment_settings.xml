<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="设置" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- 功能设置：每项点击弹出二级设置弹窗 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="功能设置" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/text_secondary" />

            <LinearLayout android:id="@+id/row_trade" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_trade">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交" android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/set_trade" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交易设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="交易模式 · 资金 · 仓位 · 重置模拟盘"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_tband" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_tband">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="做" android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/set_tband" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="做T设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="日内高抛低吸 · 数据源与档位"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_risk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_risk">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="险" android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/set_risk" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="风控设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="止损止盈 · 回撤 · 移动止盈 · 加仓"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_alert" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_alert">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="示" android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/set_alert" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="行情提醒" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="到价推送通知 · 上穿/跌破目标价"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_ai" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="14dp" android:background="@drawable/bg_row"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_row_icon"
                    android:backgroundTint="@color/set_tint_ai">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/set_ai" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AI设置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="大模型连接 · API Key · 深度解读"
                        android:textSize="12sp" android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="26sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <!-- 实盘网关 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="实盘信号" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="实盘网关URL(可选,对接QMT/EasyTrader)" android:textStyle="bold"
                    android:textSize="14sp" />
                <EditText android:id="@+id/et_gateway" android:layout_width="match_parent"
                    android:layout_height="46dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:inputType="textUri" />
                <TextView android:id="@+id/tv_gateway_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textSize="12sp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 外观 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="外观" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="外观主题" android:textStyle="bold" android:textSize="14sp" />
                <RadioGroup android:id="@+id/rg_theme" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <RadioButton android:id="@+id/rb_theme_sys" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="跟随系统" />
                    <RadioButton android:id="@+id/rb_theme_light" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="浅色" />
                    <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="深色" />
                    <RadioButton android:id="@+id/rb_theme_red" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="红色" />
                </RadioGroup>
            </LinearLayout>

            <!-- 关于与更新 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="关于与更新" android:textStyle="bold"
                android:textSize="14sp" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical"
                android:padding="14dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="当前版本" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:id="@+id/tv_version" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="新版本将直接从内置升级地址下载安装"
                    android:textSize="12sp" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/btn_check_update" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="8dp" android:text="检查更新"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>

            <TextView android:id="@+id/tv_info" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部固定保存按钮 -->
    <Button android:id="@+id/btn_save" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:text="保存设置" android:textSize="16sp"
        android:background="@drawable/bg_btn_primary" />
</FrameLayout>