<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="策略与回测" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:id="@+id/tv_running_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="引擎状态：已停止" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/et_strat_symbol" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="股票代码，如 600519" android:inputType="number" />
            <Spinner android:id="@+id/spinner_strategy" android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_backtest" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="回测" />
            <Button android:id="@+id/btn_start" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="启动自动交易" />
            <Button android:id="@+id/btn_stop" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="停止" />
        </LinearLayout>

        <TextView android:id="@+id/tv_backtest"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="12dp" android:background="#FFFFFF"
            android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="运行中策略" android:layout_marginTop="12dp" android:textStyle="bold" />
        <ListView android:id="@+id/list_active" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="#FFFFFF" />
    </LinearLayout>
</ScrollView>