<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="策略与回测" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:id="@+id/tv_running_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="引擎状态：已停止" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/et_strat_symbol" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:hint="股票代码，如 600519" android:inputType="number" />
            <Spinner android:id="@+id/spinner_strategy" android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_backtest" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:singleLine="true" android:text="回测" />
            <Button android:id="@+id/btn_start" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:singleLine="true" android:text="启动自动交易" />
            <Button android:id="@+id/btn_stop" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:singleLine="true" android:text="停止" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="策略参数(可自定义)" android:textStyle="bold" />
        <LinearLayout android:id="@+id/linear_params" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
        <Button android:id="@+id/btn_apply_params" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="保存参数" />

        <TextView android:id="@+id/tv_backtest"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="12dp" android:background="@color/card_bg"
            android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="权益曲线（策略 vs 买入持有）" android:layout_marginTop="8dp"
            android:textStyle="bold" android:textSize="14sp" />
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_equity" android:layout_width="match_parent"
            android:layout_height="180dp" android:layout_marginTop="4dp" android:background="@color/card_bg" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="运行中策略" android:layout_marginTop="12dp" android:textStyle="bold" />
        <ListView android:id="@+id/list_active" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@color/card_bg" />
    </LinearLayout>
</ScrollView>