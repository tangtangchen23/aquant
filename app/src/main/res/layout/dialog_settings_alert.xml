<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="4dp">

        <!-- 分类徽标 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:background="@drawable/chip_alert"
            android:text="行情提醒" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/set_alert" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="股价触及目标位时推送通知，方便决定是否手动下单。" />

        <!-- 添加提醒 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="添加提醒" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/set_alert" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="股票代码" />
                <EditText android:id="@+id/et_alert_symbol_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:hint="600519"
                    android:inputType="text" android:importantForAutofill="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="目标价" />
                <EditText android:id="@+id/et_alert_price_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" android:hint="1500.00"
                    android:inputType="numberDecimal" android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text="触发方向" />
                <Spinner android:id="@+id/sp_alert_dir_dialog" android:layout_width="match_parent"
                    android:layout_height="44dp" android:layout_marginTop="6dp"
                    android:minHeight="0dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:background="@drawable/bg_spinner"
                    android:textColor="@color/text_primary"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:text=" " />
                <Button android:id="@+id/btn_add_alert_dialog" android:layout_width="wrap_content"
                    android:layout_height="44dp" android:minHeight="0dp"
                    android:text="添加" android:textSize="14sp"
                    android:textColor="@color/on_brand"
                    android:paddingStart="24dp" android:paddingEnd="24dp"
                    android:background="@drawable/bg_btn_primary" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- 已设置提醒 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="已设置提醒" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/set_alert" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:id="@+id/tv_alerts_dialog"
            android:layout_marginTop="8dp" android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="11sp"
            android:textColor="@color/text_disabled"
            android:text="点击列表可暂停/恢复，长按删除最近一条。" />
    </LinearLayout>
</ScrollView>