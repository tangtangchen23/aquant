<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选股器"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="按量化策略在全市场筛选符合买入信号的股票，提升交易效率"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <!-- 股票池 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="股票池"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <Spinner
            android:id="@+id/spinner_board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="策略"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <Spinner
            android:id="@+id/spinner_strategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="扫描数量（按成交额最高的股票取前 N 只）"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
            <EditText
                android:id="@+id/et_limit"
                android:layout_width="90dp"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:inputType="number"
                android:text="100"
                android:background="@drawable/bg_input"
                android:textAlignment="viewEnd"
                android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_screen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_primary"
        android:text="开始选股"
        android:textColor="@color/on_brand" />

    <!-- 进度 -->
    <TextView
        android:id="@+id/tv_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="提示：扫描需要一点时间，建议先从小数量开始试跑"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/brand"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/list_screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>