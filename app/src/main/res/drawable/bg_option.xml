<?xml version="1.0" encoding="utf-8"?>
<!-- 分段选卡：选中=高亮描边，未选=灰底。用于 RadioGroup 选项，替代原生蓝点样式 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/seg_active_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="?attr/segActiveText" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_pressed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/seg_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>